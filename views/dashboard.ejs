<% layout('/layouts/boilerplate.ejs') %>

<div class="dashboard-container">
    <h1>Admin Dashboard</h1>
    <p>Welcome, Admin! Here's an overview of your platform's performance.</p>

    <div class="dashboard-summary">
        <div class="dashboard-card">
            <h2>Total Users</h2>
            <p><%= users.length %></p>
        </div>
        <div class="dashboard-card">
            <h2>Total Listings</h2>
            <p><%= listings.length %></p>
        </div>
        <div class="dashboard-card">
            <h2>Total Bookings</h2>
            <p><%= bookings.length %></p>
        </div>
    </div>

    <h2>Recent Users</h2>
    <table class="dashboard-table">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Total Bookings</th>
        </tr>
        <% users.slice(0, 5).forEach(user => { %>
            <tr>
                <td><%= user.username %></td>
                <td><%= user.email %></td>
                <td><%= user.phone %></td>
                <td><%= user.bookings.length %></td>
            </tr>
        <% }) %>
    </table>

    <h2>Recent Listings</h2>
    <table class="dashboard-table">
        <tr>
            <th>Title</th>
            <th>Owner</th>
            <th>Category</th>
            <th>Location</th>
        </tr>
        <% listings.slice(0, 5).forEach(listing => { %>
            <tr>
                <td><%= listing.title %></td>
                <td><%= listing.owner ? listing.owner.username : "Unknown" %></td>
                <td><%= listing.category %></td>
                <td><%= listing.location %></td>
            </tr>
        <% }) %>
    </table>

    <h2>Recent Bookings</h2>
    <table class="dashboard-table">
        <tr>
            <th>User</th>
            <th>Listing</th>
            <th>Check-in</th>
            <th>Check-out</th>
            <th>Amount</th>
            <th>Payment Status</th>
        </tr>
        <% bookings.slice(0, 5).forEach(booking => { %>
            <tr>
                <td><%= booking.user ? booking.user.username : "Unknown" %></td>
                <td><%= booking.listing ? booking.listing.title : "Unknown" %></td>
                <td><%= booking.checkIn %></td>
                <td><%= booking.checkOut %></td>
                <td>₹<%= booking.amount / 100 %></td>
                <td 
                    style="color: <%= booking.paymentStatus === 'Success' ? 'green' : booking.paymentStatus === 'Pending' ? 'orange' : 'red' %>;">
                    <%= booking.paymentStatus %>
                </td>
            </tr>
        <% }) %>
    </table>

    <a href="/" class="btn-dashboard">Go to Home</a>
</div>

<link rel="stylesheet" href="/css/dashboard.css">
