<% layout("/layouts/boilerplate.ejs") %>

<div class="container mt-3">
  <h1 class="text-center mb-4">Your Profile</h1>

  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card profile-card shadow-lg">
        <div class="card-body text-center">
          <!-- Profile Picture -->
          <div class="profile-pic mb-3 mt-3">
            <img src="https://ui-avatars.com/api/?name=<%= user.username || 'User' %>&background=random&size=120&bold=true&rounded=true" 
                 alt="Profile Picture">
          </div>

          <!-- Username -->
          <h3 class="card-title"><%= user.username || "Anonymous" %></h3>
          <hr>

          <!-- Profile Details -->
          <p><i class="fas fa-user"></i> <strong>Name:</strong> <%= user.username || "Not provided" %></p>
          <p><i class="fas fa-envelope"></i> <strong>Email:</strong> <%= user.email || "Not provided" %></p>
          
          <!-- Phone Number -->
          <p><i class="fas fa-phone"></i> <strong>Phone Number:</strong> <%= user.phone || "Not provided" %></p>

          <!-- Logout Button -->
          <div class="mt-4 mb-5">
            <form action="/logout" method="GET">
              <button class="btn btn-danger btn-custom">
                <i class="fas fa-sign-out-alt"></i> Logout
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<br/><br/>
<center>
  <h2>My Bookings</h2>
</center>
<br/>

<% if (user.bookings && user.bookings.length > 0) { %> <!-- Check if there are bookings -->
  <table class="table table-bordered table-striped">
      <thead>
          <tr>
              <th scope="col">Booking ID</th>
              <th scope="col">Listing</th>
              <th scope="col">Check-In</th>
              <th scope="col">Check-Out</th>
              <th scope="col">Amount Paid</th>
              <th scope="col">Payment ID</th>
              <th scope="col">Payment Status</th>
          </tr>
      </thead>
      <tbody>
          <% user.bookings.forEach((booking) => { %> <!-- Using forEach instead of for loop -->
              <tr>
                  <td><%= booking._id %></td> <!-- Booking ID -->
                  <td><%= booking.listing ? booking.listing.title : 'N/A' %></td>
                  <td><%= booking.checkIn ? new Date(booking.checkIn).toLocaleDateString() : 'Not provided' %></td>
                  <td><%= booking.checkOut ? new Date(booking.checkOut).toLocaleDateString() : 'Not provided' %></td>
                  <td>₹<%= booking.amount ? (booking.amount / 100).toFixed(2) : 'N/A' %></td> <!-- Convert from paise to INR -->
                  <td><%= booking.razorpay_payment_id || 'N/A' %></td> <!-- Payment ID -->
                  <td><%= booking.paymentStatus || 'Pending' %></td>
              </tr>
          <% }); %>
      </tbody>
  </table>
<% } else { %>
  <p>You have no bookings yet.</p>
<% } %>

<!-- Contact Us Section -->
<div class="container contact-us-section">
  <h3 class="text-center contact-us-heading">Need help with Booking Cancellation or Refunds?</h3>
  <p class="text-center contact-us-text">If you need assistance, please <a href="/contactus" class="contact-us-link">Contact Us</a> for support.</p>
</div>

<br/><br/><br/>

<link rel="stylesheet" href="/css/profile.css">

