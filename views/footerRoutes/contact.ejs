<% layout("/layouts/boilerplate.ejs") %>

<div class="contact-section">
    <h1>Get in Touch</h1>
    <p>Need help or have questions? Reach out to us!</p>

    <div class="contact-info-box">
        <p><strong>Email:</strong> <a href="mailto:vigneshandalam1@gmail.com">vigneshandalam1@gmail.com</a></p>
        <p><strong>Phone:</strong> <a href="tel:+919100091000">+91 9100091000</a></p>
    </div>

    <form action="/contact" method="POST">
        <label for="user-fullname">Full Name:</label>
        <input type="text" id="user-fullname" name="name" required>

        <label for="user-email">Email Address:</label>
        <input type="email" id="user-email" name="email" required>

        <label for="user-query">Your Message:</label>
        <textarea id="user-query" name="message" rows="5" required></textarea>

        <button type="submit" class="btn-send">Submit Inquiry</button>
    </form>
</div>

<link rel="stylesheet" href="/css/contact.css">

