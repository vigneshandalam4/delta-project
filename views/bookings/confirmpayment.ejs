  const amount = "<%= orderData.amount %>";
  const order_id = "<%= orderData.orderId %>";
  const listing_id = "<%= listing._id %>";
  const checkIn = "<%= booking.checkIn %>";
  const checkOut = "<%= booking.checkOut %>";
  const user_id = "<%= user._id %>";
  const username = "<%= user.username %>";
