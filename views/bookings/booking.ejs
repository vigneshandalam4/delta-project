<% layout("/layouts/boilerplate.ejs") %>

<!-- Include Flatpickr CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

<!-- Include Moment.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>

<!-- Include Flatpickr JS -->
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<script>
    const bookeddates = <%- JSON.stringify(bookedDates) %>;
</script>

<br/>
<div class="row mt-5">
  <div class="col-8 offset-3 mt-5">
        <h3>Book Your Stay</h3>
        <form id="bookingForm" action="/listings/<%= listing._id %>/book" method="POST" novalidate class="needs-validation">
            <!-- Check-in and Check-out Date Fields -->
            <div class="mb-3 mt-3">
                <label for="checkIn" class="form-label">Check-In:&ensp;&ensp;&ensp;&ensp;</label>
                <input type="date" name="booking[checkIn]" id="checkIn" required class="form-control"/>
            </div>
            <div class="mb-3">
                <label for="checkOut" class="form-label">Check-Out:&ensp;&ensp;</label>
                <input type="date" name="booking[checkOut]" id="checkOut" required class="form-control"/>
            </div>           

            <button type="submit" class="btn btn-success">Book Now</button>
        </form>
    </div>
</div>

<!-- flatpickr to block dates -->
<script src="/js/flatpickr.js"></script>
